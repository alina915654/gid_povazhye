@model WebApplication1.Models.Place

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>
<h4>Place</h4>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label fw-bold"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ImageUrl" class="control-label"></label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Type" class="control-label"></label>
                    <select asp-for="Type" class="form-select">
                        <option value="">-- Выберите --</option>
                        <option value="Еда">🍔 Еда</option>
                        <option value="Ночлег">🛏 Ночлег</option>
                        <option value="Достопримечательность">🏛 Достопримечательность</option>
                        <option value="Развлечения">🎢 Развлечения (Кино, Клубы, Активности)</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="City" class="control-label"></label>
                    <input asp-for="City" class="form-control" />
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Address" class="control-label"></label>
                <input asp-for="Address" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="WorkingHours" class="control-label"></label>
                <input asp-for="WorkingHours" class="form-control" />
            </div>

            <!-- !!! УДОБСТВА !!! -->
            <hr class="my-4">
            <h5 class="text-primary mb-3">✨ Удобства и Тип</h5>
            <div class="card bg-light border-0 p-3">
                <div class="row g-3">
                    <!-- Стандартные удобства -->
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" asp-for="HasWifi" />
                            <label class="form-check-label" asp-for="HasWifi">📶 Есть Wi-Fi</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" asp-for="HasParking" />
                            <label class="form-check-label" asp-for="HasParking">🚗 Есть Парковка</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" asp-for="HasPayment" />
                            <label class="form-check-label" asp-for="HasPayment">💳 Оплата картой</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" asp-for="HasGuide" />
                            <label class="form-check-label" asp-for="HasGuide">🗣 Есть Гид/Экскурсия</label>
                        </div>
                    </div>

                    <!-- Разделитель -->
                    <div class="col-12"><hr class="text-muted"></div>

                    <!-- ГАЛОЧКА ЭКОТУРИЗМА (Выделена зеленым) -->
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input bg-success border-success" type="checkbox" asp-for="IsEco" id="ecoSwitch">
                            <label class="form-check-label fw-bold text-success" for="ecoSwitch">
                                🌿 Это объект ЭКО-туризма (отобразить в разделе "Эко")
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <hr class="my-4">

            <!-- КОНТАКТЫ -->
            <hr class="my-4">
            <h5 class="text-primary">📞 Контакты</h5>
            <div class="alert alert-light border">
                <div class="form-group mb-3 mt-2">
                    <label class="control-label">Контактное лицо</label>
                    <input asp-for="ContactName" class="form-control" />
                </div>
                <div class="form-group mb-3">
                    <label class="control-label">Телефон</label>
                    <input asp-for="ContactPhone" class="form-control" />
                </div>
            </div>
            <hr class="my-4">

            <div class="form-group mb-3">
                <label asp-for="MapLink" class="control-label"></label>
                <input asp-for="MapLink" class="form-control" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="control-label">Широта</label>
                    <input asp-for="Latitude" class="form-control" type="number" step="any" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="control-label">Долгота</label>
                    <input asp-for="Longitude" class="form-control" type="number" step="any" />
                </div>
            </div>

            <div class="form-group form-actions">
                <input type="submit" value="Сохранить изменения" class="btn btn-primary btn-lg w-100 rounded-pill shadow" />
                <div class="mt-3 text-center">
                    <a asp-action="Index" class="text-muted text-decoration-none small">← Вернуться назад</a>
                </div>
            </div>

            <!-- Дополнительный пустой блок, чтобы кнопка не "прилипала" к низу -->
            <div style="height: 100px;"></div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}